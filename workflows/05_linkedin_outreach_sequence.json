        "jsonBody": "={\n  \"recipients\": {\n    \"values\": [{\n      \"person\": {\n        \"_path\": \"/people/{{$json.target_linkedin_id}}\"\n      }\n    }]\n  },\n  \"subject\": \"Connection Request\",\n  \"body\": \"{{$json.connection_message}}\"\n}"
