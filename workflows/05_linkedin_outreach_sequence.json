        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"query\": \"{{$json.target_name}} {{$json.target_company}} background industry\",\n  \"search_depth\": \"deep\",\n  \"sources\": [\"linkedin\", \"company_website\", \"industry_news\"],\n  \"max_results\": 10\n}"
