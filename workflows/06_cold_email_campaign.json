          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"data\": {\n    \"values\": {\n      \"name\": [{\n        \"first_name\": \"{{$json.target_name.split(' ')[0]}}\",\n        \"last_name\": \"{{$json.target_name.split(' ').slice(1).join(' ')}}\"\n      }],\n      \"email_addresses\": [{\n        \"email_address\": \"{{$json.target_email}}\"\n      }],\n      \"company_name\": [{\n        \"value\": \"{{$json.target_company}}\"\n      }],\n      \"job_title\": [{\n        \"value\": \"{{$json.target_title}}\"\n      }],\n      \"source\": [{\n        \"option\": \"cold_email\"\n      }],\n      \"lead_score\": [{\n        \"number\": {{$json.qualification_score}}\n      }],\n      \"outreach_status\": [{\n        \"option\": \"email_sequence_started\"\n      }]\n    }\n  }\n}"
      },
