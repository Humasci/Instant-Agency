    {
      "parameters": {
        "url": "http://localhost:8000/agents/phase3/rag-research/search",
        "options": {
          "headers": {
            "Content-Type": "application/json",
            "Authorization": "Bearer {{$env.API_TOKEN}}"
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"query\": \"{{$json.target_company}} {{$json.target_industry}} challenges opportunities recent news\",\n  \"search_depth\": \"deep\",\n  \"sources\": [\"company_website\", \"news\", \"industry_reports\", \"social_media\"],\n  \"max_results\": 15\n}"
      },
      "id": "email-research-002",
      "name": "Step 1 - Deep Company Research",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [460, 300]
    },
    {
      "parameters": {
        "url": "http://localhost:8000/agents/phase1/prospect-qualification/process",
        "options": {
          "headers": {
            "Content-Type": "application/json",
            "Authorization": "Bearer {{$env.API_TOKEN}}"
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"lead_name\": \"{{$json.target_name}}\",\n  \"lead_email\": \"{{$json.target_email}}\",\n  \"company\": \"{{$json.target_company}}\",\n  \"industry\": \"{{$json.target_industry}}\",\n  \"job_title\": \"{{$json.target_title}}\",\n  \"qualification_mode\": \"cold_outreach\",\n  \"research_data\": {{JSON.stringify($json.research_results)}}\n}"
      },
      "id": "email-qualify-003",
      "name": "Step 2 - Qualify Prospect",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [680, 300]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{$json.qualification_score}}",
              "operation": "largerEqual",
              "value2": 60
            }
          ]
        }
      },
      "id": "email-qualified-004",
      "name": "IF Qualified Prospect",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [900, 300]
    },
    {
      "parameters": {
        "url": "http://localhost:8000/agents/phase2/email-personalizer/personalize",
