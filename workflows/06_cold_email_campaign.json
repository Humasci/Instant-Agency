          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"recipient_info\": {\n    \"name\": \"{{$json.target_name}}\",\n    \"title\": \"{{$json.target_title}}\",\n    \"company\": \"{{$json.target_company}}\",\n    \"industry\": \"{{$json.target_industry}}\"\n  },\n  \"research_insights\": {{JSON.stringify($json.research_results)}},\n  \"email_template\": \"cold_outreach_initial\",\n  \"personalization_level\": \"high\",\n  \"call_to_action\": \"schedule_brief_call\",\n  \"value_proposition\": true\n}"
      },
      "id": "email-personalize-005",
      "name": "Step 3 - Create Personalized Email",
