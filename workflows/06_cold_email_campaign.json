        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"to_email\": \"{{$json.target_email}}\",\n  \"subject\": \"{{$json.personalized_email.subject}}\",\n  \"html_content\": \"{{$json.personalized_email.html_content}}\",\n  \"text_content\": \"{{$json.personalized_email.text_content}}\",\n  \"campaign_type\": \"cold_outreach\",\n  \"sequence_step\": 1,\n  \"lead_id\": \"{{$json.crm_record_id}}\",\n  \"personalization_data\": {\n    \"name\": \"{{$json.target_name.split(' ')[0]}}\",\n    \"company\": \"{{$json.target_company}}\",\n    \"title\": \"{{$json.target_title}}\"\n  },\n  \"tracking_enabled\": true\n}"
