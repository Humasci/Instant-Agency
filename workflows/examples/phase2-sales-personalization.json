        "options": {}
      },
      "name": "Analyze Reply Sentiment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [450, 500],
      "id": "http-request-2"
    },
    {
      "parameters": {
        "url": "http://agent-service:8000/api/v1/agents/sales/extract-intent",
