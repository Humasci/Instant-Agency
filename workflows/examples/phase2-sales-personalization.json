          "__rl": true,
          "value": "email_tracking",
          "mode": "list",
          "cachedResultName": "email_tracking"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "prospect_email": "={{$json.prospect_email}}",
            "email_subject": "={{$json.email_subject}}",
            "sent_at": "=NOW()",
            "campaign_type": "ai_sales_pitch",
