    {
      "parameters": {
        "url": "http://agent-service:8000/api/v1/agents/sales/generate-pitch",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"prospect_name\": \"{{$json.name}}\", \"company\": \"{{$json.company}}\", \"industry\": \"{{$json.industry}}\", \"pain_points\": \"{{$json.pain_points}}\", \"company_size\": \"{{$json.company_size}}\", \"trigger_event\": \"{{$json.trigger_event}}\"}",
        "options": {}
      },
      "name": "Generate Sales Pitch (GPT-Neo)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [450, 300],
      "id": "http-request-1"
    },
    {
      "parameters": {
        "fromEmail": "={{$json.sales_rep_email || 'sales@six3.agency'}}",
        "toEmail": "={{$json.prospect_email}}",
        "subject": "={{$json.email_subject}}",
        "emailType": "html",
        "message": "={{$json.email_body}}",
        "options": {
          "allowUnauthorizedCerts": false,
          "ccList": "",
          "bccList": "tracking@six3.agency",
          "replyTo": "={{$json.sales_rep_email || 'sales@six3.agency'}}",
          "senderName": "={{$json.sales_rep_name || 'Instant Agency Sales Team'}}",
          "attachments": ""
        }
      },
      "name": "Send Personalized Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [650, 300],
