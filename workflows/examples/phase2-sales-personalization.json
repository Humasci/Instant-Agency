        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"email_content\": \"{{$json.reply_text}}\"}",
        "options": {}
      },
      "name": "Extract Intent (BART Zero-Shot)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [650, 500],
      "id": "http-request-3"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-1",
              "leftValue": "={{$json.sentiment}}",
              "rightValue": "positive",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "condition-2",
              "leftValue": "={{$json.intent}}",
              "rightValue": "meeting,demo,pricing,purchase",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "name": "Check If Hot Lead",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [850, 500],
      "id": "if-1"
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "C123456789",
          "mode": "list",
          "cachedResultName": "#sales-hot-leads"
        },
        "text": "=🔥 **Hot Lead Alert!**\n\n**Prospect:** {{$json.prospect_name}}\n**Company:** {{$json.company}}\n**Sentiment:** {{$json.sentiment}} ({{$json.sentiment_score}})\n**Intent:** {{$json.intent}}\n**Reply:** \"{{$json.reply_text.substring(0, 200)}}...\"\n\n**Action Needed:** Schedule discovery call ASAP\n**CRM Link:** https://crm.@six3.agency.ai/leads/{{$json.lead_id}}",
        "otherOptions": {}
      },
      "name": "Notify Sales Team - Hot Lead",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [1050, 450],
      "id": "slack-1"
    },
    {
      "parameters": {
        "url": "http://agent-service:8000/api/v1/agents/sales/chatbot",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"message\": \"{{$json.reply_text}}\", \"context\": \"{{$json.conversation_history}}\", \"prospect_data\": {\"name\": \"{{$json.prospect_name}}\", \"company\": \"{{$json.company}}\", \"industry\": \"{{$json.industry}}\"}}",
        "options": {}
      },
      "name": "Generate Auto-Response",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1050, 550],
      "id": "http-request-4"
    },
    {
      "parameters": {
        "fromEmail": "sales@six3.agency",
        "toEmail": "={{$json.prospect_email}}",
        "subject": "=Re: {{$json.original_subject}}",
        "emailType": "html",
        "message": "={{$json.chatbot_response}}",
        "options": {
          "replyTo": "sales@six3.agency"
        }
      },
      "name": "Send Auto-Response Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [1250, 550],
      "id": "email-send-2"
    },
