        "operation": "insert",
        "table": "campaign_metrics",
        "columns": "campaign_id, timestamp, campaign_type, emails_sent, sendgrid_status, segments_targeted, next_campaign_scheduled",
        "values": "={{ $json.campaign_id }}, {{ $json.timestamp }}, {{ $json.campaign_type }}, {{ $json.emails_sent }}, {{ $json.sendgrid_status }}, {{ JSON.stringify($json.segments_targeted) }}, {{ $json.next_campaign_scheduled }}"
      },
