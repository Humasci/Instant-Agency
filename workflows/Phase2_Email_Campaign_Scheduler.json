    {
      "parameters": {
        "jsCode": "// Process AI-generated emails and prepare for SendGrid\nconst emailData = $input.first().json;\n\n// Extract personalized emails\nconst personalizedEmails = emailData.data?.personalized_emails || [];\n\n// Prepare for batch sending\nconst sendGridBatch = [];\n\nfor (const email of personalizedEmails) {\n  sendGridBatch.push({\n    to: email.recipient_email,\n    from: {\n      email: 'hello@six3.agency',\n      name: 'SIX3 Agency'\n    },\n    subject: email.subject,\n    html: email.html_content,\n    text: email.plain_text_content,\n    custom_args: {\n      campaign_type: emailData.campaign_type,\n      segment: email.segment,\n      contact_id: email.contact_id\n    },\n    tracking_settings: {\n      click_tracking: { enable: true },\n      open_tracking: { enable: true },\n      subscription_tracking: { enable: false }\n    }\n  });\n}\n\nreturn [{\n  json: {\n    batch_emails: sendGridBatch,\n    campaign_summary: {\n      total_emails: sendGridBatch.length,\n      campaign_type: emailData.campaign_type,\n      generated_at: new Date().toISOString()\n    }\n  }\n}];"
      },
      "id": "90123456-7890-1234-5678-9abcdef01234",
      "name": "Prepare SendGrid Batch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        320
      ]
    },
    {
      "parameters": {
        "operation": "sendBulk",
        "fromEmail": "hello@six3.agency",
        "fromName": "SIX3 Agency",
        "emails": "={{ $json.batch_emails }}",
        "options": {
          "sandbox": false,
          "trackClicks": true,
          "trackOpens": true
        }
      },
      "id": "a0123456-7890-1234-5678-9abcdef01234",
      "name": "Send via SendGrid",
      "type": "n8n-nodes-base.sendGrid",
      "typeVersion": 1,
      "position": [
        1560,
        320
      ]
    },
    {
      "parameters": {
        "jsCode": "// Log campaign metrics\nconst campaignData = $input.first().json;\nconst sendGridResponse = $input.last().json;\n\nconst metrics = {\n  campaign_id: `campaign_${Date.now()}`,\n  timestamp: new Date().toISOString(),\n  campaign_type: campaignData.campaign_summary.campaign_type,\n  emails_sent: campaignData.campaign_summary.total_emails,\n  sendgrid_status: sendGridResponse.status || 'sent',\n  segments_targeted: campaignData.segments || [],\n  next_campaign_scheduled: new Date(Date.now() + 7*24*60*60*1000).toISOString()\n};\n\nreturn [{ json: metrics }];"
      },
      "id": "b0123456-7890-1234-5678-9abcdef01234",
      "name": "Log Campaign Metrics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1780,
        320
      ]
    },
