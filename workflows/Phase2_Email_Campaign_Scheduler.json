      "id": "10123456-7890-1234-5678-9abcdef01234",
      "name": "Check Email Analytics",
      "type": "n8n-nodes-base.sendGrid",
      "typeVersion": 1,
      "position": [
        460,
        620
      ]
    },
    {
      "parameters": {
        "jsCode": "// Analyze email performance and trigger follow-ups\nconst analytics = $input.first().json;\n\n// Define engagement thresholds\nconst lowOpenRate = 0.15;\nconst lowClickRate = 0.02;\n\n// Check if follow-up is needed\nconst needsFollowUp = \n  analytics.open_rate < lowOpenRate || \n  analytics.click_rate < lowClickRate;\n\nif (needsFollowUp) {\n  return [{\n    json: {\n      trigger_followup: true,\n      reason: analytics.open_rate < lowOpenRate ? 'low_open_rate' : 'low_click_rate',\n      current_metrics: {\n        open_rate: analytics.open_rate,\n        click_rate: analytics.click_rate,\n        bounce_rate: analytics.bounce_rate\n      },\n      recommended_action: analytics.open_rate < lowOpenRate ? \n        'improve_subject_lines' : 'optimize_content_and_cta'\n    }\n  }];\n} else {\n  return [{\n    json: {\n      trigger_followup: false,\n      performance: 'satisfactory',\n      current_metrics: {\n        open_rate: analytics.open_rate,\n        click_rate: analytics.click_rate,\n        bounce_rate: analytics.bounce_rate\n      }\n    }\n  }];\n}"
      },
      "id": "20123456-7890-1234-5678-9abcdef01234",
      "name": "Analyze Performance",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        620
      ]
    },
