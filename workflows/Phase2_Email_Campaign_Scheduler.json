      "id": "2b3c4d5e-6f78-9012-3456-789abcdef012",
      "name": "Get Subscribed Contacts",
      "type": "n8n-nodes-base.attio",
      "typeVersion": 1,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Segment contacts based on their profile and behavior\nconst contacts = $input.all();\nconst segments = {\n  new_subscribers: [],\n  active_users: [],\n  enterprise_prospects: [],\n  small_business: []\n};\n\nfor (const contact of contacts) {\n  const data = contact.json;\n  \n  // Determine segment based on company size and engagement\n  if (data.created_at && new Date(data.created_at) > new Date(Date.now() - 30*24*60*60*1000)) {\n    segments.new_subscribers.push(data);\n  } else if (data.company_size && data.company_size === 'Enterprise') {\n    segments.enterprise_prospects.push(data);\n  } else if (data.engagement_score && data.engagement_score > 70) {\n    segments.active_users.push(data);\n  } else {\n    segments.small_business.push(data);\n  }\n}\n\n// Return segmented data\nreturn Object.entries(segments).map(([segment, contacts]) => ({\n  json: {\n    segment_name: segment,\n    contacts: contacts,\n    contact_count: contacts.length,\n    campaign_type: segment === 'new_subscribers' ? 'welcome_series' :\n                   segment === 'enterprise_prospects' ? 'enterprise_demo' :\n                   segment === 'active_users' ? 'feature_updates' : 'educational_content'\n  }\n}));"
      },
      "id": "3c4d5e6f-7890-1234-5678-90abcdef1234",
      "name": "Segment Contacts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "mode": "chooseBranch",
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "={{ $json.segment_name }}",
            "operations": [
              {
                "operation": {
                  "type": "string",
                  "operation": "equals",
                  "rightValue": "new_subscribers"
                },
                "id": "branch1"
              },
              {
                "operation": {
                  "type": "string",
                  "operation": "equals",
                  "rightValue": "enterprise_prospects"
                },
                "id": "branch2"
              },
              {
                "operation": {
                  "type": "string",
                  "operation": "equals",
                  "rightValue": "active_users"
                },
                "id": "branch3"
              },
              {
                "operation": {
                  "type": "string",
                  "operation": "equals",
                  "rightValue": "small_business"
                },
                "id": "branch4"
              }
            ]
          }
        }
      },
      "id": "4d5e6f78-9012-3456-7890-abcdef123456",
