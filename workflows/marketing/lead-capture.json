{
  "name": "Marketing: Lead Capture",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-capture",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Webhook - New Lead",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "lead-capture"
    },
    {
      "parameters": {
        "functionCode": "// Extract and validate lead data\nconst body = $input.item.json.body;\n\nreturn {\n  json: {\n    name: body.name || '',\n    email: body.email || '',\n    company: body.company || '',\n    phone: body.phone || '',\n    source: body.source || 'website',\n    message: body.message || '',\n    timestamp: new Date().toISOString(),\n    lead_score: 0\n  }\n};"
      },
      "name": "Extract Lead Data",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.email}}",
              "operation": "isNotEmpty"
            },
            {
              "value1": "={{$json.name}}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "name": "Validate Required Fields",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://agent-service:8000/marketing/research-prospect",
        "jsonParameters": true,
        "options": {},
        "bodyParametersJson": "={\n  \"company_name\": \"{{$json.company}}\",\n  \"email\": \"{{$json.email}}\"\n}"
      },
      "name": "Research Prospect",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [850, 200]
    },
    {
      "parameters": {
        "operation": "insert",
        "table": "leads",
        "columns": "name,email,company,phone,source,message,lead_score,created_at",
        "values": "={{$json.name}},={{$json.email}},={{$json.company}},={{$json.phone}},={{$json.source}},={{$json.message}},={{$json.lead_score}},={{$json.timestamp}}"
      },
      "name": "Save to Database",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [1050, 200],
      "credentials": {
        "postgres": {
          "name": "PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.CRM_URL}}/api/leads",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "jsonParameters": true,
        "options": {},
        "bodyParametersJson": "={\n  \"name\": \"{{$json.name}}\",\n  \"email\": \"{{$json.email}}\",\n  \"company\": \"{{$json.company}}\",\n  \"phone\": \"{{$json.phone}}\",\n  \"source\": \"{{$json.source}}\",\n  \"description\": \"{{$json.message}}\"\n}"
      },
      "name": "Create CRM Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1250, 200]
    },
    {
      "parameters": {
        "to": "={{$json.email}}",
        "subject": "Thanks for your interest!",
        "emailType": "html",
        "message": "=<p>Hi {{$json.name}},</p>\n<p>Thank you for your interest in Instant Agency. We've received your message and will get back to you within 24 hours.</p>\n<p>In the meantime, check out our resources:</p>\n<ul>\n  <li><a href=\"https://@six3.agency.ai/blog\">Blog</a></li>\n  <li><a href=\"https://@six3.agency.ai/case-studies\">Case Studies</a></li>\n  <li><a href=\"https://@six3.agency.ai/demo\">Product Demo</a></li>\n</ul>\n<p>Best regards,<br>The Instant Agency Team</p>"
      },
      "name": "Send Welcome Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [1450, 200],
      "credentials": {
        "smtp": {
          "name": "SMTP"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://agent-service:8000/sales/qualify",
        "jsonParameters": true,
        "options": {},
        "bodyParametersJson": "={\n  \"lead_id\": {{$json.id}},\n  \"responses\": {\n    \"email\": \"{{$json.email}}\",\n    \"company\": \"{{$json.company}}\",\n    \"message\": \"{{$json.message}}\"\n  }\n}"
      },
      "name": "Qualify Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1050, 350]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{$json.data.overall_score}}",
              "operation": "largerEqual",
              "value2": 7
            }
          ]
        }
      },
      "name": "High Quality Lead?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1250, 350]
    },
    {
      "parameters": {
        "to": "sales@six3.agency",
        "subject": "🔥 Hot Lead: {{$json.name}} from {{$json.company}}",
        "emailType": "html",
        "message": "=<h2>High-Quality Lead Received</h2>\n<p><strong>Name:</strong> {{$json.name}}<br>\n<strong>Company:</strong> {{$json.company}}<br>\n<strong>Email:</strong> {{$json.email}}<br>\n<strong>Phone:</strong> {{$json.phone}}<br>\n<strong>Qualification Score:</strong> {{$json.data.overall_score}}/10</p>\n<p><strong>Message:</strong><br>{{$json.message}}</p>\n<p><a href=\"{{$env.CRM_URL}}/leads/{{$json.id}}\">View in CRM</a></p>"
      },
      "name": "Notify Sales Team",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [1450, 300]
    },
    {
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "string": [
            {
              "name": "status",
              "value": "error"
            },
            {
              "name": "message",
              "value": "Missing required fields"
            }
          ]
        }
      },
      "name": "Error Response",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [850, 400]
    }
  ],
  "connections": {
    "Webhook - New Lead": {
      "main": [
        [
          {
            "node": "Extract Lead Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Lead Data": {
      "main": [
        [
          {
            "node": "Validate Required Fields",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Required Fields": {
      "main": [
        [
          {
            "node": "Research Prospect",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Error Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Research Prospect": {
      "main": [
        [
          {
            "node": "Save to Database",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save to Database": {
      "main": [
        [
          {
            "node": "Create CRM Lead",
            "type": "main",
            "index": 0
          },
          {
            "node": "Qualify Lead",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create CRM Lead": {
      "main": [
        [
          {
            "node": "Send Welcome Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Qualify Lead": {
      "main": [
        [
          {
            "node": "High Quality Lead?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "High Quality Lead?": {
      "main": [
        [
          {
            "node": "Notify Sales Team",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {},
