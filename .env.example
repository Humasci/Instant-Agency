# Email Service Configuration
# Choose your email provider: 'mailtrap' for development/testing, 'mailgun' for production
EMAIL_PROVIDER=mailtrap

# Mailtrap Configuration (Recommended for Development/Testing)
# Safe email testing - captures all emails without sending to real recipients
# Get credentials from: https://mailtrap.io/ > Email Testing > Inboxes
MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=2525
MAILTRAP_SMTP_USERNAME=your_mailtrap_username
MAILTRAP_SMTP_PASSWORD=your_mailtrap_password
MAILTRAP_INBOX_ID=your_inbox_id
MAILTRAP_API_TOKEN=your_api_token

# Mailtrap Sender Configuration
MAILTRAP_FROM_EMAIL=hello@six3.agency
MAILTRAP_FROM_NAME=SIX3 Agency

# Mailgun Configuration (For Production Use)
MAILGUN_API_KEY=your_mailgun_api_key_here
MAILGUN_DOMAIN=your_mailgun_domain_here
MAILGUN_FROM_EMAIL=hello@your_domain.com
MAILGUN_FROM_NAME=SIX3 Agency

# Attio CRM Configuration
ATTIO_API_KEY=your_attio_api_key_here

# General Email Configuration
CONTACT_EMAIL=form@six3.agency