# Instant Agency - Environment Configuration
# Copy this file to .env and update with your actual values

#==============================================================================
# CORE SETTINGS
#==============================================================================
NODE_ENV=production
DOMAIN=instant-agency.local
TZ=America/New_York
DEBUG=false

#==============================================================================
# DATABASE CONFIGURATION
#==============================================================================
POSTGRES_DB=instant_agency
POSTGRES_USER=instant_agency
POSTGRES_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD

# Metabase Database
METABASE_DB=metabase

# CRM Database
CRM_DB_NAME=suitecrm

#==============================================================================
# REDIS CONFIGURATION
#==============================================================================
REDIS_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD

#==============================================================================
# N8N WORKFLOW AUTOMATION
#==============================================================================
N8N_USER=admin
N8N_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_EXECUTION_MODE=regular
WEBHOOK_URL=http://localhost:5678
EXECUTIONS_TIMEOUT=3600
EXECUTIONS_TIMEOUT_MAX=7200

#==============================================================================
# SUITECRM CONFIGURATION
#==============================================================================
CRM_USERNAME=admin
CRM_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD
CRM_EMAIL=admin@instant-agency.ai
CRM_HOST=localhost:8080

#==============================================================================
# METABASE ANALYTICS
#==============================================================================
# First-time setup via UI

#==============================================================================
# CHROMA VECTOR DATABASE
#==============================================================================
CHROMA_AUTH_PROVIDER=chromadb.auth.token.TokenAuthServerProvider
CHROMA_AUTH_TOKEN=CHANGE_ME_TO_SECURE_TOKEN
CHROMA_AUTH_HEADER=X-Chroma-Token

#==============================================================================
# GRAFANA MONITORING
#==============================================================================
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD

#==============================================================================
# AI & ML CONFIGURATION
#==============================================================================
# Hugging Face API (Required)
# Get your token at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Default models (can be changed)
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.2
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Model parameters
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_TOP_P=0.9

#==============================================================================
# EMAIL CONFIGURATION
#==============================================================================
# Choose one: sendgrid, mailgun, smtp, gmail
EMAIL_PROVIDER=sendgrid

# SendGrid
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@instant-agency.ai
SENDGRID_FROM_NAME=Instant Agency

# Mailgun
MAILGUN_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
MAILGUN_DOMAIN=mg.instant-agency.ai

# SMTP (Generic)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

#==============================================================================
# SOCIAL MEDIA APIs (Optional - Phase 2+)
#==============================================================================
# LinkedIn
LINKEDIN_CLIENT_ID=xxxxxxxxxxxxxxxx
LINKEDIN_CLIENT_SECRET=xxxxxxxxxxxxxxxx
LINKEDIN_ACCESS_TOKEN=xxxxxxxxxxxxxxxx

# Twitter/X
TWITTER_API_KEY=xxxxxxxxxxxxxxxx
TWITTER_API_SECRET=xxxxxxxxxxxxxxxx
TWITTER_ACCESS_TOKEN=xxxxxxxxxxxxxxxx
TWITTER_ACCESS_SECRET=xxxxxxxxxxxxxxxx
TWITTER_BEARER_TOKEN=xxxxxxxxxxxxxxxx

# Facebook/Meta
FACEBOOK_APP_ID=xxxxxxxxxxxxxxxx
FACEBOOK_APP_SECRET=xxxxxxxxxxxxxxxx
FACEBOOK_PAGE_ACCESS_TOKEN=xxxxxxxxxxxxxxxx

#==============================================================================
# EXTERNAL SERVICES (Optional)
#==============================================================================
# Company data enrichment
CLEARBIT_API_KEY=xxxxxxxxxxxxxxxx
APOLLO_API_KEY=xxxxxxxxxxxxxxxx

# Calendar integration
GOOGLE_CALENDAR_CLIENT_ID=xxxxxxxxxxxxxxxx
GOOGLE_CALENDAR_CLIENT_SECRET=xxxxxxxxxxxxxxxx

# Payment processing
STRIPE_API_KEY=sk_test_xxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

#==============================================================================
# MONITORING & LOGGING (Optional)
#==============================================================================
LOG_LEVEL=info

# Sentry error tracking
SENTRY_DSN=https://xxxxxxxxxxxxxxxx@sentry.io/xxxxxxx
SENTRY_ENVIRONMENT=production

#==============================================================================
# SECURITY
#==============================================================================
# Generate secure random strings for these
JWT_SECRET=GENERATE_RANDOM_SECRET_HERE
ENCRYPTION_KEY=GENERATE_RANDOM_KEY_HERE

#==============================================================================
# PERFORMANCE TUNING
#==============================================================================
# Agent settings
AGENT_RESPONSE_TIMEOUT=30
AGENT_RETRY_ATTEMPTS=3

# Rate limiting
EMAIL_RATE_LIMIT=100
API_RATE_LIMIT=1000

# Caching
CACHE_TTL=3600
ENABLE_REDIS_CACHE=true
