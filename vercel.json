{
  "version": 2,
  "functions": {
    "api/**/*.ts": {
      "runtime": "@vercel/node@3.2.0"
    }
  },
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/",
      "destination": "/status_dashboard.html"
    },
    {
      "source": "/dashboard",
      "destination": "/status_dashboard.html" 
    },
    {
      "source": "/control-panel",
      "destination": "/control-panel-visual.html"
    },
    {
      "source": "/status",
      "destination": "/status_dashboard.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        },
        {
          "key": "X-Frame-Options", 
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}